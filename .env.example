# Copia este archivo como `.env.local` y reemplazá los valores con los reales.
# `.env.local` está en `.gitignore` — no se commitea.

# Supabase — DB
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-<region>.pooler.supabase.com:5432/postgres"

# Supabase — Auth + cliente
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Resend (opcional, para envío real de emails desde el reporte mensual)
# RESEND_API_KEY=re_...
# RESEND_FROM="invIT <hola@tu-dominio.com>"
